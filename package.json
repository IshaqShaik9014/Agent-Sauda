{
  "name": "agent-sauda",
  "version": "0.1.0",
  "private": true,
  "description": "AI agents negotiate. Merchants stay in control.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@agent-sauda/api",
    "dev:web": "npm run dev --workspace=@agent-sauda/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "db:ping": "tsx scripts/ping-db.ts",
    "db:generate": "npm run db:generate --workspace=@agent-sauda/database",
    "db:push": "npm run db:push --workspace=@agent-sauda/database",
    "db:seed": "npm run db:seed --workspace=@agent-sauda/database",
    "db:studio": "npm run db:studio --workspace=@agent-sauda/database"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
